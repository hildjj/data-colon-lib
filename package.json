{
  "name": "data-colon-lib",
  "version": "0.0.0",
  "description": "Create and parse data URIs",
  "main": "lib/index.js",
  "type": "module",
  "scripts": {
    "parser": "peggy -c peggy.config.js ",
    "prebuild": "npm run parser",
    "build": "tsup",
    "lint": "eslint .",
    "pretest": "npm run build -- --sourcemap inline --no-minify --no-dts",
    "test": "c8 node --test test/*.test.js",
    "posttest": "tsup --silent",
    "docs": "typedoc",
    "clean": "rimraf docs lib coverage src/grammar.js src/grammar.d.ts",
    "ci": "npm run test && npm run docs"
  },
  "keywords": [
    "rfc2397",
    "rfc2396",
    "datacolon",
    "data",
    "uri",
    "url",
    "parser",
    "mime"
  ],
  "author": "Joe Hildebrand <joe-github@cursive.net>",
  "license": "MIT",
  "files": [
    "lib/"
  ],
  "dependencies": {
    "iana-media-type": "0.1.44",
    "uint8array-extras": "1.4.0"
  },
  "devDependencies": {
    "@cto.af/eslint-config": "6.0.13",
    "@eslint/markdown": "7.1.0",
    "@types/node": "24.2.1",
    "@typescript-eslint/eslint-plugin": "8.39.0",
    "@typescript-eslint/parser": "8.39.0",
    "c8": "10.1.3",
    "eslint": "9.33.0",
    "eslint-plugin-jsdoc": "52.0.4",
    "peggy": "github:peggyjs/peggy",
    "rimraf": "6.0.1",
    "ts-node": "10.9.2",
    "tsup": "8.5.0",
    "typedoc": "0.28.9",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=18.8"
  }
}
